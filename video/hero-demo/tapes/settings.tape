# Shared look of the terminal scenes: 1920x1080, the hero video's dark stage with one ember accent
# (colours from mdview's Atelier theme), Geist Mono. Sourced by the scene tapes.
Set Shell bash
Set Width 1920
Set Height 1080
Set FontFamily "Geist Mono"
Set FontSize 26
Set LineHeight 1.35
Set Padding 64
Set Margin 0
Set Framerate 30
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme { "name": "mdview-ember", "background": "#140e0b", "foreground": "#f4ede7", "cursor": "#e9590c", "selection": "#3a2a20", "black": "#1a120e", "red": "#ff6b5a", "green": "#9bc78f", "yellow": "#f3a072", "blue": "#9bb4d9", "magenta": "#d9a0c8", "cyan": "#8fc9c2", "white": "#d8cec6", "brightBlack": "#5f524a", "brightRed": "#ff8a7a", "brightGreen": "#b3d6a9", "brightYellow": "#f7c4a6", "brightBlue": "#b8cbe6", "brightMagenta": "#e6bcd9", "brightCyan": "#aedbd5", "brightWhite": "#f4ede7" }
